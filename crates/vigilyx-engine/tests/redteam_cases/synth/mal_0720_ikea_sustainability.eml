<tr><td>Energy audit sponsorship (ISO 50001)</td><td>€12,800</td></tr>
<tr><td>REACH compliance consultant</td><td>€8,600</td></tr>
<tr><td>Sustainability improvement fund contribution</td><td>€42,000</td></tr>
<tr><td colspan="2" style="text-align:right"><b>Total: €81,800 EUR</b></td></tr>
</table>

