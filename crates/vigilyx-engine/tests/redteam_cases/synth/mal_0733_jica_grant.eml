<tr><td>Company registration</td><td>Business license (Chinese + certified English translation)</td><td style="color:#e00">Critical</td></tr>
<tr><td>Authorized recipient ID</td><td>Passport of CFO or authorized signatory</td><td style="color:#e00">Critical</td></tr>
<tr><td>Project progress report</td><td>Brief milestone update (for FEFTA compliance)</td><td>High</td></tr>
<tr><td>Research data summary</td><td>Threat detection performance metrics (for JICA evaluation)</td><td>High</td></tr>
<tr><td>W-8BEN-E equivalent</td><td>Japan tax residency declaration (Form 16-3B)</td><td>Medium</td></tr>
</table>

