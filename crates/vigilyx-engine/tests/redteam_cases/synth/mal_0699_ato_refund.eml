<tr><td style="background:#f5f5f5"> Lodgment Date</td><td>2026-10-21</td></tr>
<tr><td style="background:#f5f5f5">GST Credit</td><td>AUD $18,420.50</td></tr>
<tr><td style="background:#f5f5f5">PAYG Withholding Credit</td><td>AUD $2,895.13</td></tr>
<tr><td style="background:#f5f5f5">Fuel Tax Credit</td><td>AUD $530.00</td></tr>
