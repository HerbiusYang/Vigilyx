# ═══════════════════════════════════════════════════
# Vigilyx main-service Dockerfile (API + Frontend control plane)
# ═══════════════════════════════════════════════════
#
# Architecture notes:
#   The API is the control plane. Mirror deployments run the Engine in the
#   dedicated engine service; MTA deployments embed it in the MTA container.
#   The engine binary remains in this image only for the legacy
#   STANDALONE_ENGINE=true compatibility path.
#   After the frontend is built into static files, it is served directly by the API via axum ServeDir.
#   To run the engine separately, use the mirror profile's `engine` service in
#   docker-compose.yml.
#
# Build:
#   docker build -f deploy/docker/Dockerfile.api -t vigilyx:latest .
#
# Run:
#   docker run -d --name vigilyx \
#     -p 8088:8088 \
#     -v vigilyx_data:/app/data \
#     -e REDIS_URL=redis://redis:6379 \
#     vigilyx:latest

# -- Stage 1: cargo-chef - extract the dependency recipe --
FROM rust:1.98.0-bookworm@sha256:e70e2eec3d495fd5c8e0be74adda86507dfac7f51a724fbf9813ff59b2b247c7 AS chef
RUN cargo install cargo-chef --locked --version 0.1.78
WORKDIR /app

# -- Stage 2: generate the dependency recipe (no source files, only Cargo.toml/Cargo.lock) --
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo chef prepare --recipe-path recipe.json

# -- Stage 3: build dependencies (accelerated with BuildKit cache mounts) --
FROM chef AS rust-deps
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo chef cook --release --recipe-path recipe.json && \
    rm -rf /app/target/release/.fingerprint/vigilyx-*

# -- Stage 4: build Rust binaries --
FROM rust-deps AS rust-builder
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY shared ./shared
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release -p vigilyx-api -p vigilyx-engine && \
    cp /app/target/release/vigilyx-api /app/vigilyx-api && \
    cp /app/target/release/vigilyx-engine /app/vigilyx-engine

# -- Stage 5: build the frontend --
FROM node:24.19.0-bookworm@sha256:934240a162082fd8b8a2f90cd5114446443f1eba1c5378f6687167ca405e6584 AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install -g npm@12.0.2 && npm ci --prefer-offline
COPY frontend ./
RUN npm run build

# -- Stage 6: final runtime image --
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

# Runtime dependencies (ca-certificates: HTTPS; tini: PID 1 signal forwarding; curl: health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    tini \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Rust binaries (artifacts produced by the cache-mount stage)
COPY --from=rust-builder /app/vigilyx-api ./
COPY --from=rust-builder /app/vigilyx-engine ./

# Copy frontend static files (API ServeDir::new("frontend/dist") expects this path)
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Copy the curated EML corpus used as offline AI training samples.
COPY crates/vigilyx-engine/tests/redteam_cases ./test-corpus/redteam_cases

# Copy the entrypoint script
COPY deploy/docker/entrypoint.sh ./
RUN chmod +x entrypoint.sh

# Create the data directory (heartbeat files + runtime data)
RUN mkdir -p /app/data/tmp/http

# SEC-C01: run as a non-root user (CWE-250)
RUN groupadd -r vigilyx && useradd -r -g vigilyx -d /app vigilyx \
    && chown -R vigilyx:vigilyx /app
USER vigilyx

# Default environment variables
ENV RUST_LOG=info,vigilyx_api=info,vigilyx_engine=info \
    LOG_FORMAT=json \
    API_HOST=0.0.0.0 \
    API_PORT=8088 \
    DATABASE_URL=postgres://vigilyx:MUST_SET_VIA_ENV@postgres:5432/vigilyx \
    REDIS_URL=redis://redis:6379

EXPOSE 8088

# Health check: API liveness probe; aggregate readiness is exposed separately.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -sf http://127.0.0.1:8088/api/health/live || exit 1

# tini runs as PID 1 so signals are forwarded correctly to the entrypoint.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./entrypoint.sh"]
