# ============================================
# Vigilyx Docker deployment environment configuration
# ============================================
#
# First deployment:
#   Recommended:
#   1. From the project root, run: bash scripts/generate-secrets.sh
#   2. Review and adjust deploy/docker/.env
#
#   Manual template flow:
#   1. cp .env.example .env
#   2. Replace every <CHANGE_ME> below with strong random values
#   3. chmod 600 .env
#
# !! Security warning !!
#   - The .env file contains sensitive credentials and must never be committed to git
#   - Every <CHANGE_ME> must be replaced or the service will refuse to start
#   - Do not use sample values or weak passwords in production
#   - Prefer generate-secrets.sh to create cryptographically secure random values automatically
#
# ============================================

# -- Database (PostgreSQL) --
PG_USER=vigilyx
PG_PASSWORD=<CHANGE_ME>
PG_DB=vigilyx
PG_API_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_PG_PASSWORD>
PG_ENGINE_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_PG_PASSWORD>
PG_MTA_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_PG_PASSWORD>
# PG_PORT=5433                       # PostgreSQL external mapped port (default: 5433)
# PG_MIGRATION_LOCK_TIMEOUT_MS=15000 # Fail instead of queueing schema DDL behind a backup/long transaction
# Memory settings below retain small-host defaults. On the current 128 GiB
# server: PG_SHARED_BUFFERS=8GB, PG_EFFECTIVE_CACHE_SIZE=64GB,
# PG_MAINTENANCE_WORK_MEM=512MB. Budget for the engine and build containers too.
# effective_cache_size is a planner estimate, not a memory allocation.
# Changing these Compose command options requires recreating postgres.
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=512MB
# PG_MAINTENANCE_WORK_MEM=128MB
# PG_LOG_LOCK_WAITS=on               # Log waits longer than deadlock_timeout

# ── Redis ──
REDIS_PASSWORD=<CHANGE_ME>
REDIS_API_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_REDIS_PASSWORD>
REDIS_ENGINE_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_REDIS_PASSWORD>
REDIS_SNIFFER_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_REDIS_PASSWORD>
REDIS_MTA_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_REDIS_PASSWORD>
# REDIS_PORT=6379                    # Redis external mapped port (default: 6379)

# -- Optional operational read cache (separate from the message bus) --
# Enable explicitly with READ_CACHE_ENABLED=true and
# docker compose --profile read-cache up -d. Keep this credential different
# from REDIS_PASSWORD. The cache has no persistent volume and may evict keys.
# READ_CACHE_ENABLED=false
# deploy.sh does not start it automatically; after configuration, run:
# docker compose -f deploy/docker/docker-compose.yml --profile read-cache up -d cache
# CACHE_REDIS_PASSWORD=<CHANGE_ME_DIFFERENT_FROM_REDIS_PASSWORD>
# CACHE_DEPLOYMENT_ID=production
# CACHE_MAXMEMORY=256mb
# Each aggregate dataset is disabled by default; enable one or more as needed.
# CACHE_SECURITY_STATS_ENABLED=false
# CACHE_DELIVERY_STATS_ENABLED=false
# CACHE_LOGIN_STATS_ENABLED=false
# CACHE_SESSION_COUNTS_ENABLED=false
# CACHE_SECURITY_STATS_SHADOW_WRITE=false

# -- API authentication --
# JWT signing key (at least 32 chars; 64 hex chars recommended)
API_JWT_SECRET=<CHANGE_ME>
# Dedicated key for encrypted SMTP/webhook/intelligence credentials.
# Keep independent from API_JWT_SECRET so JWT rotation cannot destroy config.
VIGILYX_CONFIG_ENCRYPTION_KEY=<CHANGE_ME_DIFFERENT_FROM_API_JWT_SECRET>
# Initial admin password (the system forces a change after first login)
# Must be set explicitly. The service refuses to start if unset.
API_PASSWORD=<CHANGE_ME>
# Independent privacy-audit account. The one-shot bootstrap never overwrites
# an existing user and forces this password to be changed at first login.
AUDIT_USERNAME=privacy-auditor
AUDIT_BOOTSTRAP_PASSWORD=<CHANGE_ME_STRONG_UNIQUE_PASSWORD>
# API_USERNAME=admin                 # Admin username (default: admin)
# API_TOKEN_EXPIRE_HOURS=12          # JWT expiration time (default: 12 hours)
# Force the Secure cookie flag. MUST stay true in production when served through Caddy/TLS;
# set to false only for temporary plain-HTTP debugging (including remote IP tests);
# restore true before normal use. Browsers do not send Secure cookies over remote HTTP.
API_SECURE_COOKIE=true
# API_LISTEN=127.0.0.1               # Listen on localhost by default; change to 0.0.0.0 only for temporary non-TLS external testing
# API_PORT=8088                      # API external mapped port (default: 8088)
# TRUSTED_PROXY_IPS=127.0.0.1,::1    # Local reverse proxies are trusted by default; keep these and append any extra LB/WAF IPs
# TRUSTED_PROXY_HOSTS=localhost,host.docker.internal,caddy,vigilyx-caddy
# INTERNAL_API_SOURCE_CIDRS=127.0.0.1/32,::1/128,172.30.250.0/24
#                                   # Host/Compose Caddy is already covered by default; preserve these defaults when adding custom proxies

# -- Inter-service authentication --
MQ_AUTH_TOKEN=<CHANGE_ME_DIFFERENT_FROM_INTERNAL_API_TOKEN>
# Internal component auth token (sniffer/engine <-> API)
INTERNAL_API_TOKEN=<CHANGE_ME>
SNIFFER_API_TOKEN=<CHANGE_ME_DIFFERENT_FROM_INTERNAL_API_TOKEN>
MTA_API_TOKEN=<CHANGE_ME_DIFFERENT_FROM_INTERNAL_API_TOKEN>
# Dedicated AI service token (API/engine -> AI / VT scrape); must differ from INTERNAL_API_TOKEN
AI_INTERNAL_TOKEN=<CHANGE_ME_DIFFERENT_FROM_INTERNAL_API_TOKEN>

# -- Optional semantic intent model --
# Fine-tuned encoder ensemble scored inside the engine; the result is recorded in
# semantic_scan details. Load the vigilyx_intent_models volume first
# (scripts/semantic_intent_poc/README.md). Empty keeps it off.
# SEMANTIC_INTENT_MODEL_DIR=/app/models/intent/semantic-intent-v2
# SEMANTIC_INTENT_THREADS=4
# Without a scoring threshold the model runs in shadow mode beside the semantic
# rule analysis and never changes verdicts. With one, the model replaces the rule
# analysis and a score at or above it is a Low semantic result in the verdict.
# Set it from the real-traffic score distribution, not the packaged dev threshold.
# SEMANTIC_INTENT_SCORE_THRESHOLD=0.90

# -- Optional CAPEv2 sandbox --
# Required only when building/starting the sandbox profile. Full 40-character
# commit SHA only; tags, branches, and abbreviated SHAs are rejected.
# CAPEV2_REF=0123456789abcdef0123456789abcdef01234567

# -- Network capture --
# Timezone used by containers and UI time rendering. Keep this aligned with the server's NTP-synchronized system timezone.
SERVER_TIMEZONE=Asia/Shanghai
# Network interface (adjust to your environment: common Linux values are eth0/ens33, macOS uses en0)
SNIFFER_INTERFACE=eth0
# SNIFFER_PROMISCUOUS=true           # Promiscuous mode (default: true)
# SNIFFER_CAPTURE_BUFFER_MB=256      # libpcap capture buffer in MB; raise further on very bursty mirror traffic
# SNIFFER_WORKERS=16                 # Sniffer worker threads; mirrored email traffic usually does not need dozens of workers
# SNIFFER_WORKER_CPU_LIST=           # Optional worker CPU list, e.g. 0-15; host tuning reserves it from NIC IRQs
# SNIFFER_CAPTURE_CPU=               # Optional dedicated libpcap reader CPU; keep it outside the worker list
# SMTP_PORTS=25,465,587,2525,2526    # SMTP ports (defaults already include common ports)
# POP3_PORTS=110,995                 # POP3 ports
# IMAP_PORTS=143,993                 # IMAP ports
# HTTP_PORTS=80,443,8080             # Initial value; API settings/defaults override it when they return a non-empty port list
# SNIFFER_HOST_TUNING=true           # Controls the manually invoked capture-host tuning helper; deploy.sh does not tune the host
# SNIFFER_HOST_SET_RING_MAX=true     # Raise the NIC RX/TX ring to its maximum when ethtool supports it
# SNIFFER_HOST_NETDEV_MAX_BACKLOG=250000
# SNIFFER_HOST_NETDEV_BUDGET=1200
# SNIFFER_HOST_NETDEV_BUDGET_USECS=8000
# SNIFFER_HOST_RMEM_MAX=1073741824
# SNIFFER_HOST_RMEM_DEFAULT=67108864
# SNIFFER_HOST_RPS_FLOW_ENTRIES=65536
# SNIFFER_HOST_IRQ_REBALANCE=true    # Rebalance capture NIC IRQs away from reserved sniffer worker CPUs
# SNIFFER_HOST_IRQ_CPU_LIST=         # Optional explicit IRQ CPU list, e.g. 16-23,32-39
# SNIFFER_HOST_IRQ_EXCLUDE_CPUS=     # Optional CPUs to keep free from NIC IRQs
# SNIFFER_HOST_IRQ_DISABLE_IRQBALANCE=false

# -- Passive mirror outbound attribution --
# SMTP egress/relay IPs or CIDRs observed by the sniffer. A local MAIL FROM
# from an untrusted source is retained as "unknown" instead of bypassing DLP.
# OUTBOUND_SMTP_RELAY_IPS=10.1.1.20,10.1.1.0/24

# -- MTA proxy mode (requires docker compose --profile mta) --
# Vigilyx MTA acts as an inbound security proxy and can also accept authenticated/trusted internal submissions for external delivery.
# MTA_LOCAL_DOMAINS must list your real recipient domains, comma-separated; leaving it empty causes all RCPT TO commands to be rejected.
# MTA_LOCAL_DOMAINS=example.com,example.org
# Trusted submission/upstream relays that may originate local-domain senders.
# Comma-separated exact IPs or CIDRs; leave empty to treat all unauthenticated SMTP clients as external.
# MTA_TRUSTED_UPSTREAM_CIDRS=10.0.0.0/24,192.168.1.10
# MTA_DOWNSTREAM_HOST=10.0.0.25      # Downstream real MTA / mail-gateway address
# MTA_DOWNSTREAM_PORT=25
# MTA_DOWNSTREAM_STARTTLS=true   # Disable only if the downstream MTA does not support STARTTLS
# MTA_OUTBOUND_HOST=10.0.0.26        # Optional outbound smart host for internal -> external mail
# MTA_OUTBOUND_PORT=587
# MTA_OUTBOUND_STARTTLS=true
# MTA_MAX_CONNECTIONS_PER_IP=10  # raise only for trusted multiplexing relays
# MTA_MESSAGE_MEMORY_BUDGET_MB=256 # Shared DATA/BDAT budget across connections, range 32-1024 MiB
# MTA_DLP_ENABLED=true
# MTA_DLP_ACTION=quarantine          # block | quarantine | allow_and_alert
# MTA_DLP_MIN_LEVEL=3
# MTA_INLINE_TIMEOUT_SECS=8
# MTA_MAX_RECIPIENTS=50            # Per-message policy; UI/DB may override, valid range 1-10000
# MTA_FAIL_OPEN=false                # false = return 451; true = attempt relay after engine failure (outbound DLP still applies)
# TLS is mandatory with the secure defaults. Put a PEM certificate and private
# key at these host paths (relative paths are resolved from deploy/docker/).
# Keep the private key mode 600; mta-cert-install copies it into an MTA-only volume.
# MTA_TLS_CERT_SOURCE=./certs/mta.crt
# MTA_TLS_KEY_SOURCE=./certs/mta.key
# MTA_REQUIRE_STARTTLS=true          # true = plaintext sessions get 530 5.7.0 on MAIL FROM until STARTTLS completes
# MTA_SMTP_PORT=25                  # Container listener and matching host port
# MTA_SMTPS_PORT=465                # Container listener and matching host port
# MTA_HOSTNAME=mx1.example.com
# Optional exact authserv-id allowlist for trusted upstream gateways in
# passive mirror/import sessions. Blank by default: inbound Authentication-
# Results are treated as untrusted unless the MTA stamped them itself.
# VIGILYX_TRUSTED_AUTH_SERV_IDS=mx.example.com,mail.protection.outlook.com
# MTA_LISTEN: host-side port bind address (left side of docker-compose ports), controlling which NICs expose SMTP
# MTA_LISTEN=127.0.0.1             # Default: loopback only. Set to 0.0.0.0 or a specific NIC IP if external access is needed
# MTA_LISTEN_HOST: in-container bind address for the MTA process; usually no change is needed
# MTA_LISTEN_HOST=0.0.0.0          # Default: all interfaces inside the container
# Do not set either listener port to 587 until SMTP AUTH is implemented.

# -- AI service (optional; direct Compose use requires --profile ai) --
AI_ENABLED=false
# Optional visual OCR for inline/CID images already contained in email MIME.
# It never fetches external image URLs; enable only when the AI profile is running.
AI_VISUAL_OCR_ENABLED=false
# Optional dedicated HMAC key for deterministic training-export redaction.
# If omitted, the API derives the redaction namespace from API_JWT_SECRET.
VIGILYX_TRAINING_REDACTION_KEY=
# External LLM second opinions are disabled unless this is explicitly enabled.
# Even when enabled, high-risk DLP content is blocked and prompt fields are redacted.
# LLM_EXTERNAL_EGRESS_ENABLED=false
# Internal domains to exclude from third-party reputation lookups (comma-separated).
# VIGILYX_INTERNAL_DOMAINS=corp.example,bank.internal
# HuggingFace endpoint (mainland China users should uncomment the mirror)
# HF_ENDPOINT=https://hf-mirror.com
# VIGILYX_NUM_THREADS=32             # AI inference thread count (Compose default: 32)
# AI_MAX_CONCURRENCY=4               # Concurrent NLP inference requests
# AI_VT_MAX_CONCURRENCY=2            # Concurrent VirusTotal scrape requests
# AI_NLP_SEGMENT_CHARS=3000          # NLP per-segment chars for long-body segmented inference (R5 A1)
# AI_NLP_MAX_SEGMENTS=8              # max segments per email (cost cap)
# REMOTE_LISTEN_TOKEN=               # optional token handshake for sniffer --remote-listen (R5 F7)

# -- Logging --
# RUST_LOG=info,vigilyx_api=info,vigilyx_engine=info
# RUST_LOG_SNIFFER=info,vigilyx_sniffer=info
# Do not use debug logging in production (CPU overhead becomes extreme)

# -- TLS (in production, using host Caddy/Nginx is recommended; see ../../DEPLOYMENT.md) --
# The variables below are only for the built-in Caddy / ./deploy.sh --tls bootstrap flow
# Domain -> auto-request certificates by default; IP/localhost -> fall back to Caddy internal CA by default
# VIGILYX_DOMAIN=vigilyx.example.com
# VIGILYX_DOMAIN=192.0.2.10
# CADDY_TLS_MODE=auto                # Optional override: auto | internal | files
# CADDY_ACCESS_LOG=true              # Built-in Caddy access log to stdout (set false to disable)
# CADDY_ACME_EMAIL=ops@example.com   # Recommended in auto mode so certificate notices have a recipient
# VIGILYX_TLS_CERT_FILE=/data/vigilyx.crt
# VIGILYX_TLS_KEY_FILE=/data/vigilyx.key

# -- Advanced options --
# PORTAL_MODE=false                  # Portal mode: redirect / to /portal
# API_CORS_ORIGINS=                  # Allowed CORS origins (comma-separated; * is for development only)
# FRONTEND_DIST=../../frontend/dist  # Only for docker-compose.dev.yml; path is relative to deploy/docker on the remote host
# CLAMAV_ENABLED=false               # Enable ClamAV modules; engine containers must be recreated after changing this; deploy.sh starts it on backend/data-plane deployments
# CLAMAV_HOST=clamav                 # ClamAV address (requires --profile antivirus)
# CLAMAV_PORT=3310                   # ClamAV port
# YARA_PACK_MANIFEST=                # Immutable manifest under /app/data, e.g. /app/data/yara-packs/<generation>/manifest.json
# YARA_PACK_MIN_RULES=0              # Set to the approved generation count floor; generation activates atomically or not at all
# YARA_PACK_ALLOWED_LICENSES=MIT,Apache-2.0,BSD-2-Clause,BSD-3-Clause,DRL-1.1,DRUL-1.0,GPL-2.0-only,GPL-3.0-only # Engine rule-pack license allowlist
# ENGINE_MAX_CONCURRENT_EMAILS=       # Optional 1-1024 override; 10k+ rule packs default to a CPU-sized bound (max 64)
# ENGINE_INLINE_WORKERS=4             # MTA inline SMTP workers (1-64); bounded so one slow message cannot serialize the entrance
# VIGILYX_NESTED_MESSAGE_IDENTITY_FREEZE_ENABLED=false # Stage-B nested .eml compound; keep off until separately shadow-validated
# VIGILYX_EMAIL_SEMANTIC_STAGE_B=false # Opt-in additive email-semantic rules; enable only for separately shadowed candidates
# VIGILYX_EXTERNAL_CREDENTIAL_LINK_STAGE_B=false # Narrow same-window account/service-password link compound; opt in per deployment
# VIGILYX_REPLY_TO_HANDOFF_STAGE_B=false # Narrow local sensitive-data handoff routed through an external Reply-To
# VIGILYX_EMAIL_ATTACK_HARDENING_STAGE_B=false # Exact device-login aliases and bounded Unicode QR recovery; independently evaluated Stage B
# SANDBOX_URL=http://sandbox:8000    # CAPEv2 sandbox URL (experimental, requires --profile sandbox)
# SANDBOX_API_TOKEN=                 # Required to enable submissions; blank disables sandbox calls
# SANDBOX_TIMEOUT_SECS=300           # Sandbox analysis timeout
# SANDBOX_URL_ANALYSIS_ENABLED=false # Opt-in: detonate selected external URLs in CAPE's isolated browser/VM
# SANDBOX_URL_ANALYSIS_TIMEOUT_SECS=120 # Per-URL dynamic analysis budget (30-300 seconds)
# Process-level URL worker (stage 2/3, disabled until a reviewed profile and worker are installed)
# PROCESS_SANDBOX_ENABLED=false
# PROCESS_SANDBOX_LAUNCHER=/usr/bin/bwrap
# PROCESS_SANDBOX_WORKER=/usr/local/libexec/vigilyx-url-worker
# PROCESS_SANDBOX_PROFILE=offline_snapshot_v1
# PROCESS_SANDBOX_LAUNCHER_ARGS=["--die-with-parent","--new-session","--unshare-user","--unshare-pid","--unshare-net","--unshare-ipc","--unshare-uts","--clearenv","--ro-bind","/usr","/usr","--ro-bind","/bin","/bin","--ro-bind","/lib","/lib","--ro-bind","/lib64","/lib64","--proc","/proc","--dev","/dev","--tmpfs","/tmp","--ro-bind","/usr/local/libexec/vigilyx-url-worker","/usr/local/libexec/vigilyx-url-worker","--"]
# PROCESS_SANDBOX_TIMEOUT_SECS=20
# PROCESS_SANDBOX_MAX_OUTPUT_BYTES=65536
# PROCESS_SANDBOX_MAX_STDERR_BYTES=16384
# PROCESS_SANDBOX_MAX_MEMORY_BYTES=1073741824
# PROCESS_SANDBOX_MAX_CPU_SECS=15
# LLM_TIMEOUT_SECS=5              # LLM second-opinion hard timeout (must stay under the engine NLP 8s budget)
# LLM_MAX_CONCURRENCY=2           # Max concurrent LLM API calls from the AI service
# LLM_RATE_LIMIT_PER_MINUTE=2     # Per-sender LLM second-opinion rate limit
# LLM_GLOBAL_RATE_LIMIT_PER_MINUTE=20  # Global LLM call cap (sender-rotation proof); queue time counts against the timeout budget
# RELEASE_RESCAN_TIMEOUT_SECS=30  # Quarantine release: wait budget for the mandatory pre-release rescan verdict (decoupled from MTA inline budget)
