# ═══════════════════════════════════════════════════
# Vigilyx MTA proxy Dockerfile (SMTP relay + embedded engine)
# ═══════════════════════════════════════════════════
#
# Full-build mode: multi-stage cargo-chef build inside Docker, suitable for CI/CD and clean environments.
# For day-to-day development, use Dockerfile.mta.fast with the persistent build container.
#
# Build:
#   docker build -f deploy/docker/Dockerfile.mta -t vigilyx-mta:latest .
#
# Runtime:
#   Use deploy/docker/docker-compose.yml for the supported MTA setup. It provides
#   the required database/Redis credentials and safely stages the TLS key for
#   the non-root MTA user.
#   A direct docker run must join the existing Vigilyx network, set
#   DATABASE_URL, REDIS_URL, VIGILYX_CONFIG_ENCRYPTION_KEY, and MQ_AUTH_TOKEN,
#   mount readable TLS certificate/key files, and set MTA_TLS_CERT,
#   MTA_TLS_KEY, and MTA_SMTPS_PORT=465 when publishing port 465. The image
#   exposes 465 but does not enable its listener unless TLS and the port are
#   explicitly configured.

# -- Stage 1: cargo-chef - extract the dependency recipe --
FROM rust:1.98.0-bookworm@sha256:e70e2eec3d495fd5c8e0be74adda86507dfac7f51a724fbf9813ff59b2b247c7 AS chef
RUN cargo install cargo-chef --locked --version 0.1.78
WORKDIR /app

# -- Stage 2: generate the dependency recipe --
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo chef prepare --recipe-path recipe.json

# -- Stage 3: build dependencies (accelerated with BuildKit cache mounts) --
FROM chef AS rust-deps
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo chef cook --release --recipe-path recipe.json && \
    rm -rf /app/target/release/.fingerprint/vigilyx-*

# -- Stage 4: build the MTA binary --
FROM rust-deps AS builder
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY shared ./shared
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release -p vigilyx-mta && \
    cp /app/target/release/vigilyx-mta /app/vigilyx-mta

# -- Stage 5: runtime image --
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/vigilyx-mta ./

RUN mkdir -p /app/data /app/logs /app/certs

# SEC-C01: non-root user
RUN groupadd -r vigilyx && useradd -r -g vigilyx -d /app vigilyx \
    && chown -R vigilyx:vigilyx /app
USER vigilyx

# Default environment variables
# SEC-18: fail closed by default, consistent with docker-compose.yml
# (${MTA_FAIL_OPEN:-false}) and the code default in crates/vigilyx-mta/src/config.rs.
# Only set MTA_FAIL_OPEN=true explicitly if delivery must take priority over scanning.
ENV RUST_LOG=info,vigilyx_mta=info,vigilyx_engine=info \
    MTA_LISTEN_HOST=0.0.0.0 \
    MTA_SMTP_PORT=25 \
    MTA_INLINE_TIMEOUT_SECS=8 \
    MTA_FAIL_OPEN=false \
    MTA_MAX_CONNECTIONS=100 \
    MTA_MAX_RECIPIENTS=50 \
    MTA_HOSTNAME=vigilyx-mta

# Health check: attempt an SMTP connection
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD echo "QUIT" | curl -s telnet://127.0.0.1:25 || exit 1

# SMTP ports
EXPOSE 25 465

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./vigilyx-mta"]
